# Environment Configuration - Rename to .env and fill in values

# Application
NODE_ENV=production
PORT=4000

# Database (MongoDB Atlas M0 in production)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parsswim?retryWrites=true&w=majority

# Sessions & Cookies
SESSION_SECRET=your-strong-random-session-secret-min-32-chars
COOKIE_SECRET=your-strong-random-cookie-secret-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=https://parsswim.dev

# Payment Gateway (Zarinpal)
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_SANDBOX=false

# Server IP/Domain (for reverse proxy)
SERVER_IP=your-server-public-ip
