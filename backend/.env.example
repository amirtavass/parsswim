# Environment Configuration - Rename to .env and fill in values

# Application
NODE_ENV=production
PORT=4000

# Database (Azure Cosmos DB for MongoDB — free tier)
MONGODB_URL=mongodb://<account>:<key>@<account>.mongo.cosmos.azure.com:10255/parsswim?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@<account>@

# Sessions & Cookies
SESSION_SECRET=your-strong-random-session-secret-min-32-chars
COOKIE_SECRET=your-strong-random-cookie-secret-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=https://parsswim.dev

# Payment Gateway (Zarinpal)
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_SANDBOX=false

# Server IP/Domain (for reverse proxy)
SERVER_IP=your-server-public-ip

# AWS S3 (uploads + backups)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_UPLOADS_BUCKET=parsswim-uploads
S3_BACKUPS_BUCKET=parsswim-backups

# S3 overrides for LocalStack / MinIO (leave unset for real AWS)
# S3_ENDPOINT=http://localhost:4566
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=http://localhost:4566/parsswim-uploads
