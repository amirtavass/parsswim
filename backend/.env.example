# Environment Configuration - Rename to .env and fill in values

# Application
NODE_ENV=production
PORT=4000

# Database (MongoDB Atlas M0 free tier)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parsswim?retryWrites=true&w=majority

# Sessions & Cookies
SESSION_SECRET=your-strong-random-session-secret-min-32-chars
COOKIE_SECRET=your-strong-random-cookie-secret-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=https://parsswim.dev

# Payment Gateway (Zarinpal)
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_SANDBOX=false

# Server IP/Domain (for reverse proxy)
SERVER_IP=your-server-public-ip

# ============================================================================
# Object storage (S3 API: AWS S3, Cloudflare R2, or LocalStack)
# ============================================================================
# The canonical S3_* names below select the provider purely through env:
#   - Real AWS S3: leave S3_ENDPOINT empty, use a real region (eu-north-1).
#   - Cloudflare R2: set S3_ENDPOINT to the R2 endpoint, region "auto".
#   - LocalStack: set S3_ENDPOINT to http://localhost:4566, region us-east-1.
# Legacy AWS_*/R2_* variable names are still read as fallbacks.
#
# AWS S3 (primary)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Only for temporary STS credentials (AWS Academy / assumed roles); omit for IAM keys.
# S3_SESSION_TOKEN=
S3_REGION=eu-north-1
S3_UPLOADS_BUCKET=parsswim-uploads
S3_BACKUPS_BUCKET=parsswim-backups
S3_PUBLIC_BASE_URL=https://parsswim-uploads.s3.eu-north-1.amazonaws.com
S3_FORCE_PATH_STYLE=false

# Cloudflare R2 (fallback; same code, only env changes)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_REGION=auto
# S3_UPLOADS_BUCKET=parsswim-uploads
# S3_BACKUPS_BUCKET=parsswim-backups
# S3_PUBLIC_BASE_URL=https://uploads.parsswim.dev
# S3_FORCE_PATH_STYLE=true

# LocalStack (local dev/CI only)
# S3_ENDPOINT=http://localhost:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_REGION=us-east-1
# S3_UPLOADS_BUCKET=parsswim-uploads
# S3_BACKUPS_BUCKET=parsswim-backups
# S3_PUBLIC_BASE_URL=http://localhost:4566/parsswim-uploads
# S3_FORCE_PATH_STYLE=true
